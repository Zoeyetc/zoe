{
  "name": "computational-listening-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:zoe": "vite --config apps/zoe/vite.config.ts",
    "dev:zland": "vite --config apps/zland/vite.config.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "build": "npm run build:zoe && npm run build:zland",
    "build:zoe": "npm run typecheck -w @computational-listening/zoe && vite build --config apps/zoe/vite.config.ts",
    "build:zland": "npm run typecheck -w @zland/music-box-app && vite build --config apps/zland/vite.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
