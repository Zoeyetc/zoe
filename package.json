{
  "name": "zland-music-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
